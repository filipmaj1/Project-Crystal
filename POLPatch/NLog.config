<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <target name="logfile" xsi:type="File" fileName="${processdir}/logs/patch-${shortdate}.log" layout="[${date:format=dd/MM/yy HH\:mm\:ss}][${uppercase:${level}}] ${message}" />
    <target name="logconsole" xsi:type="Console" layout="[${uppercase:${level}}] ${message}" />
  </targets>
  
  <rules>
    <logger name='Crystal.*' minlevel='Trace' writeTo='logconsole' />
	  <logger name='Crystal.*' minlevel='Trace' writeTo='logfile' />
  </rules>

</nlog>